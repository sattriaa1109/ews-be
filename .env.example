# Database
DATABASE_URL=postgresql://ews_user:ews_pass@localhost:5432/ews_db

# Scraper
SCRAPE_INTERVAL_MINUTES=15
# Jumlah feed yang diunduh bersamaan (default 8)
SCRAPER_MAX_WORKERS=8

# Tambahan RSS feed sumber berita (opsional, pisahkan dengan koma).
# Sumber default (ANTARA, CNN Indonesia, Sindonews, CNBC Indonesia, Tribunnews,
# JPNN, iNews, Katadata, Kemhan, BNN, Google News, dan ANTARA regional) sudah
# otomatis aktif dari config.py. Isi variabel ini hanya jika ingin menambah feed lain.
# Contoh: RSS_FEEDS=https://www.antaranews.com/rss/olahraga.xml
RSS_FEEDS=

# Google Custom Search Engine (Programmable Search) API (opsional).
# Aktifkan dengan mengisi API key dan Search Engine ID (cx).
# Buat API key: https://developers.google.com/custom-search/v1/overview
# Buat/kelola CSE: https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Query pencarian (pisahkan dengan koma). Kosongkan untuk pakai default.
# GOOGLE_CSE_QUERIES=TNI AD,Kodam,TNI Angkatan Darat,Oknum TNI,Prajurit TNI
# Jumlah hasil per query, maks 10 (default 10).
# GOOGLE_CSE_NUM_RESULTS=10
