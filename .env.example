# Database
DATABASE_URL=postgresql://ews_user:ews_pass@localhost:5432/ews_db

# Telegram Bot (buat dari @BotFather, ambil chat_id grup/channel tujuan)
TELEGRAM_BOT_TOKEN=isi_token_bot_disini
TELEGRAM_CHAT_ID=isi_chat_id_disini

# Scraper
SCRAPE_INTERVAL_MINUTES=15
# Jumlah feed yang diunduh bersamaan (default 8)
SCRAPER_MAX_WORKERS=8

# Tambahan RSS feed sumber berita (opsional, pisahkan dengan koma).
# Sumber default (ANTARA, CNN Indonesia, Sindonews, CNBC Indonesia, Tribunnews,
# JPNN, iNews, Katadata, Kemhan, BNN, Google News, dan ANTARA regional) sudah
# otomatis aktif dari config.py. Isi variabel ini hanya jika ingin menambah feed lain.
# Contoh: RSS_FEEDS=https://www.antaranews.com/rss/olahraga.xml
RSS_FEEDS=
